# Generated data - do not edit by hand.
# rts_tile_masks[I]: two chars per tile column J (alphabet rts_mask_alphabet, 5 bits each, high first) = 9-bit
# land mask of the tile's 3 x 3 cells, bit di * 3 + dj (di = fine row in the tile, editor X; dj = column, editor Y).
# 0 = no tile there. Fine cell (3I + di, 3J + dj) is 1/3 degree: latitude -60 + (3I + di + 0.5) / 3.

rts_mask_alphabet:string = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

